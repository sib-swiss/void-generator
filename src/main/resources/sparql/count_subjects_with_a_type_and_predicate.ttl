@prefix ex: <https://purl.expasy.org/sparql-examples/void-generator/sparql/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix sd: <http://www.w3.org/ns/sparql-service-description#> .


ex:count_subjects_with_a_type_and_predicate a sh:SPARQLExecutable,
        sh:SPARQLSelectExecutable ;
    rdfs:comment "Count the number of predicate linksets, and how many distinct subjects they involve (?count == ?distinctSubjects proves the predicate is functional for this class; comparing ?distinctSubjects to the class' void:entities count proves whether it is required)."^^rdf:HTML ;
    sh:prefixes _:sparql_examples_prefixes ;
    sh:select """SELECT
  (COUNT(?subject) AS ?count) (COUNT(DISTINCT ?subject) AS ?distinctSubjects)
WHERE {
  GRAPH ?graph {
  	?subject a ?sourceClass ;
      ?predicate ?target.
  }
}""" ;
    schema:keywords "void" , "predicate", "count", "type" ;
    schema:target [
        a sd:Service
    ] .
